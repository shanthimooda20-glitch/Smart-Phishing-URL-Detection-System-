# Copy to `.env` and adjust. Never commit the real .env file.

# "development", "testing" or "production"
FLASK_ENV=development

# Secret key used for Flask session signing / CSRF-style protections.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# SQLAlchemy connection string (defaults to a local SQLite file)
DATABASE_URL=sqlite:///phishing.db

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Maximum accepted URL length (characters)
MAX_URL_LENGTH=2048
